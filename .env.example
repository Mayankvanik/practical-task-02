# ─── Qdrant Cloud ─────────────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=nasa_handbook

# ─── OpenAI (for embeddings + LLM) ───────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# ─── Embedding dims (must match model above) ─────────────────────────────────
# text-embedding-3-small  → 1536
# text-embedding-3-large  → 3072
EMBEDDING_DIM=1536

# ─── PDF Source ───────────────────────────────────────────────────────────────
NASA_PDF_URL=https://www.nasa.gov/wp-content/uploads/2018/09/nasa_systems_engineering_handbook_0.pdf
             
# ─── Paths ────────────────────────────────────────────────────────────────────
PDF_PATH=data/nasa_handbook.pdf
FIGURES_DIR=outputs/figures
TABLES_DIR=outputs/tables
CHUNKS_DIR=outputs/chunks
